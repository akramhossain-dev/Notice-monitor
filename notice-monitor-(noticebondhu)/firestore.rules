rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Websites collection: Public can read active websites
    match /websites/{websiteId} {
      allow read: if isValidId(websiteId);
      allow write: if false; // server-side admin only
    }

    // Notices collection: Public can view notices
    match /notices/{noticeId} {
      allow read: if isValidId(noticeId);
      allow write: if false; // server-side scraper only
    }

    // Subscribers collection
    match /subscribers/{subscriberId} {
      allow read: if false;
      allow create: if isValidId(subscriberId) &&
                    request.resource.data.email is string &&
                    request.resource.data.email.size() <= 200;
      allow update, delete: if false;
    }

    // Subscriptions collection
    match /subscriptions/{subId} {
      allow read: if false;
      allow create: if isValidId(subId);
      allow update, delete: if false;
    }

    // Logs: Internal server only
    match /alert_logs/{logId} {
      allow read, write: if false;
    }

    match /check_logs/{logId} {
      allow read, write: if false;
    }
  }
}
