{
  "entities": {
    "Website": {
      "title": "Website",
      "description": "Monitored Bangladeshi educational board, university, or government website",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "nameBn": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 500 },
        "selector": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "enum": ["board", "university", "college", "government", "public_service"] },
        "intervalMinutes": { "type": "number" },
        "enabled": { "type": "boolean" },
        "isJsHeavy": { "type": "boolean" },
        "lastCheckedAt": { "type": "string" },
        "lastCheckStatus": { "type": "string", "enum": ["success", "failed", "pending"] },
        "lastCheckError": { "type": "string", "maxLength": 500 },
        "totalNoticesFound": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "nameBn", "url", "selector", "category", "intervalMinutes", "enabled", "createdAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Detected official notice item extracted from a monitored website",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "websiteId": { "type": "string", "maxLength": 128 },
        "websiteName": { "type": "string", "maxLength": 200 },
        "websiteNameBn": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 500 },
        "link": { "type": "string", "maxLength": 1000 },
        "detectedAt": { "type": "string" },
        "publishDate": { "type": "string", "maxLength": 100 },
        "isInitialRun": { "type": "boolean" },
        "category": { "type": "string" }
      },
      "required": ["id", "websiteId", "websiteName", "title", "link", "detectedAt", "category"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Student or applicant subscribed to notice alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "telegramChatId": { "type": "string", "maxLength": 100 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "unsubToken": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "email", "isActive", "createdAt", "unsubToken"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Mapping between a subscriber and a monitored website",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "subscriberId": { "type": "string", "maxLength": 128 },
        "websiteId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "subscriberId", "websiteId", "createdAt"]
    },
    "AlertLog": {
      "title": "AlertLog",
      "description": "Dispatch record of an email or Telegram notification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "subscriberId": { "type": "string", "maxLength": 128 },
        "subscriberEmail": { "type": "string", "maxLength": 200 },
        "telegramChatId": { "type": "string", "maxLength": 100 },
        "noticeId": { "type": "string", "maxLength": 128 },
        "noticeTitle": { "type": "string", "maxLength": 500 },
        "websiteName": { "type": "string", "maxLength": 200 },
        "channel": { "type": "string", "enum": ["email", "telegram"] },
        "status": { "type": "string", "enum": ["sent", "simulated", "failed"] },
        "error": { "type": "string", "maxLength": 500 },
        "sentAt": { "type": "string" }
      },
      "required": ["id", "subscriberId", "noticeId", "channel", "status", "sentAt"]
    },
    "CheckLog": {
      "title": "CheckLog",
      "description": "Scraping audit log for a check execution",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "websiteId": { "type": "string", "maxLength": 128 },
        "websiteName": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["success", "failed"] },
        "noticesFound": { "type": "number" },
        "newNoticesCount": { "type": "number" },
        "durationMs": { "type": "number" },
        "error": { "type": "string", "maxLength": 500 },
        "checkedAt": { "type": "string" }
      },
      "required": ["id", "websiteId", "websiteName", "status", "noticesFound", "checkedAt"]
    }
  },
  "firestore": {
    "/websites/{websiteId}": {
      "schema": "Website",
      "description": "Monitored websites list"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Detected notices directory"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Subscribers registry"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "User website subscriptions"
    },
    "/alert_logs/{logId}": {
      "schema": "AlertLog",
      "description": "Notification delivery audit logs"
    },
    "/check_logs/{logId}": {
      "schema": "CheckLog",
      "description": "Scraping execution logs"
    }
  }
}
